! References
! CuteXTerm:        https://github.com/csdvrx/CuteXterm/blob/main/.Xresources
! Copy-Paste:       https://unix.stackexchange.com/questions/225062/how-can-i-copy-text-from-xterm-awesome-debian-virtualbox
! Themes:           https://github.com/janoamaral/Xresources-themes/tree/master
! Color cheatsheet: https://www.tweaking4all.com/software/linux-software/xterm-color-cheat-sheet/

! Fonts
XTerm*vt100.faceName:           xft:Droid Sans Mono:size=10:antialias=true:style=Regular
XTerm*vt100.boldFont:           xft:Droid Sans Mono:size=10:antialias=true:style=Bold
! XTerm*vt100.faceName:           xft:DejaVu Sans Mono:size=10:antialias=true:style=Regular
! XTerm*vt100.boldFont:           xft:DejaVu Sans Mono:size=10:antialias=true:style=Bold

! Locale settings
!XTerm.vt100.locale: false
XTerm.vt100.utf8: true
XTerm.VT100.utf8Title: true
!XTerm.vt100.wideChars: true
XTerm*menuLocale: "C"

! Theme
XTerm*dynamicColors: true
XTerm*termName: xterm-256color
#include "/home/dgemoli/dev/config/xorg/base16-google-dark-256.Xresources"

! Mouse
XTerm*pointerShape:             left_ptr
! Xcursor.size: 64
*VT100.scrollbar.translations:  #override \n\
    <Btn5Down>:     StartScroll(Forward) \n\
    <Btn1Down>:     StartScroll(Continuous) MoveThumb() NotifyThumb() \n\
    <Btn4Down>:     StartScroll(Backward) \n\
    <Btn1Motion>:   MoveThumb() NotifyThumb() \n\
    <BtnUp>:        NotifyScroll(Proportional) EndScroll()

! Scrollbar
XTerm*rightScrollBar: True
XTerm*saveLines: 4096

! Geometry adapted to my 4k screen
XTerm.VT100.geometry: 88x23
! XTerm*fullscreen: true
! xTerm*Maximized: true

! Only select text, not empty space around it.
XTerm*highlightSelection: true

! Enable clipboard
XTerm*vt100.selectToClipboard: true

! Allow regular colors, italics and underline
XTerm*underLine: true
XTerm*VT100.colorMode: True
XTerm*VT100.colorBDMode: false
XTerm*VT100.colorITMode: false
XTerm*colorULMode: off
XTerm*italicULMode: false

! Dont toggle the 8th bit
XTerm.vt100.metaSendsEscape: true

! Dont send Ctrl-H for Backspace
XTerm.vt100.backarrowKey: false
XTerm.ttyModes: erase ^?

! No border
XTerm*borderWidth: 0
XTerm*VT100.internalBorder: 0

! Miscellanea
XTerm*VT100.Translations: #override \
                 Ctrl Shift <Key>V:    insert-selection(CLIPBOARD) \n\
                 Ctrl Shift <Key>C:    copy-selection(CLIPBOARD)

XTerm*toolBar: false

! Fix font size
XTerm.Xft.dpi: 128

! #include "/home/dgemoli/dev/src/github.com/altercation/solarized/xresources/solarized"

